---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

{
  /* FIXME: Disable CSP for now, since the default is currently to strict to run in an admin UI iframe. */
}
<BaseLayout csp={new Map<string, string>()}>
  <div class="flex size-full flex-col gap-2 bg-red-200 p-4">
    <div class="rounded-sm bg-white p-2">
      <p>
        update or reinstall with{" "}
        <span class="font-mono">
          {" trail components add trailbase/auth_ui "}
        </span>
      </p>
    </div>

    {
      /* We can't have Astro inline JS w/o validating admin UI's CSP, thus this indirection */
    }
    <div id="solid-root"></div>
  </div>
</BaseLayout>

<script>
  import { adminClient } from "@/lib/admin-client";
  import { buildPage } from "@/components/admin/Page";

  async function test() {
    console.debug(document.head.baseURI, document.cookie, localStorage);
    const client = adminClient();
    if (!client) {
      console.error("no client");
      return;
    }

    console.log("TOKENS: ", client.tokens());

    const response = await client.fetch("_/auth/admin/settings/");
    const settings = await response.json();
    console.log("SETTINGS:", settings);
  }

  test();

  buildPage("solid-root");
</script>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

{
  /* FIXME: Disable CSP for now, since the default is currently to strict to run in an admin UI iframe. */
}
<BaseLayout csp={new Map<string, string>()}>
  {/* See below */}
  <div id="solid-root"></div>
</BaseLayout>

<script>
  import { renderAdminUI } from "@/components/admin/SettingsPage";

  // Astro inlines the JS from client:only components into the html. W/o a safety
  // hash or nonce, this would be in vialoation of admin UI's root CSP. We thus
  // have this render indirection via the <script> tag, which Astro pulls out
  // of the template into a separete JS file.
  renderAdminUI("solid-root");

  console.debug("LOCATION:", window.location, "doc.baseURI:");
  console.debug("DOC BASE:", document.head.baseURI);
  console.debug("COOKIES & STORAGE:", document.cookie, localStorage);
</script>

{
  "name": "trailbase-admin-ui",
  "version": "0.0.1",
  "description": "TrailBase's Admin Dashboard",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "check:format": "prettier -c .",
    "format": "prettier -w .",
    "proto": "protoc --plugin=protoc-gen-ts=node_modules/ts-proto/protoc-gen-ts_proto ../../../core/proto/*.proto -I../../../core/proto -I/usr/include --ts_out=./proto/ --ts_opt=esModuleInterop=true,initializeFieldsAsUndefined=false,forceLong=bigint",
    "check": "tsc --noEmit --skipLibCheck && eslint && vitest run",
    "test": "vitest run"
  },
  "dependencies": {
    "@antv/x6": "^3.1.8",
    "@bufbuild/protobuf": "^2.14.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@corvu/resizable": "^0.2.5",
    "@kobalte/core": "^0.13.13",
    "@kobalte/tailwindcss": "^0.9.0",
    "@kobalte/utils": "^0.9.2",
    "@lezer/highlight": "^1.2.3",
    "@nanostores/persistent": "^1.3.5",
    "@nanostores/solid": "^1.1.1",
    "@panzoom/panzoom": "^4.6.2",
    "@solid-primitives/memo": "^1.5.1",
    "@solidjs/router": "^1.0.0",
    "@tanstack/solid-form": "^1.33.5",
    "@tanstack/solid-query": "^5.102.2",
    "@tanstack/solid-table": "^8.21.3",
    "@tanstack/table-core": "^8.21.3",
    "@tiledb-inc/wkx": "github:TileDB-Inc/wkx",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "geojson": "^0.5.0",
    "i18n-iso-countries": "^7.14.0",
    "long": "^5.3.2",
    "maplibre-gl": "^6.6.0",
    "nanostores": "^1.5.2",
    "rapidoc": "^9.3.8",
    "solid-icons": "^1.2.0",
    "solid-js": "^1.9.15",
    "tailwind-merge": "^3.6.0",
    "trailbase": "file:../client",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/tabler": "^1.2.38",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.6",
    "@types/geojson": "^7946.0.16",
    "@types/wicg-file-system-access": "^2023.10.7",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-solid": "^0.16.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "ts-proto": "^2.12.1",
    "tw-animate-css": "^1.4.0",
